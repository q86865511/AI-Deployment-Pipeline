# AI-Deployment-Pipeline 環境變數範本
# 複製為 .env 後依實際環境填寫：  cp .env.example .env
# docker-compose 會自動讀取同目錄的 .env

# --- 安全相關（部署前務必設定）---

# Grafana 管理員密碼（必填，未設定時 docker-compose 會直接報錯）
GF_SECURITY_ADMIN_PASSWORD=

# 允許跨來源請求的前端網址，逗號分隔。
# 開發預設 http://localhost:3000；正式部署請改成實際前端網域。
CORS_ORIGINS=http://localhost:3000

# --- 服務連線 ---

# Triton Inference Server 位址（容器內預設）
TRITON_URL=http://triton:8000

# 模型儲存庫路徑（容器內預設）
MODEL_REPOSITORY_PATH=/app/model_repository

# 前端呼叫後端 API 的位址
REACT_APP_API_URL=http://localhost:8000
